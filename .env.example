# Copiá este archivo a ".env" y ajustá los valores para tu entorno.
# ".env" NO se sube al repo (ver .gitignore); estos son los valores que hoy
# están hardcodeados en grafiexpress/settings.py.

# Django
# OJO: si tu SECRET_KEY tiene "$", hay que escribirlo como "$$" en este archivo
# (docker-compose interpola "$" como variables al leer .env; "$$" es el
# literal). Ejemplo real de la clave que ya estaba en settings.py:
SECRET_KEY=1p@z$$ky1ym)o+0-&nlwrg6$$shj&#f@(l-q4t7kq&5ljh(ea$$8r
DEBUG=True
# Lista separada por comas, ej: grafiexpress.com,www.grafiexpress.com
ALLOWED_HOSTS=

# Base de datos PostgreSQL
DB_NAME=grafiexpress2
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=192.168.11.220
DB_PORT=5432

# Gunicorn
WEB_CONCURRENCY=3
