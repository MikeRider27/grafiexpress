# Copiá este archivo a ".env" y ajustá los valores ("make init" lo hace solo).
# ".env" NO se sube al repo (ver .gitignore).
# OJO: si algún valor tiene "$", escribilo como "$$" (docker compose
# interpola "$" como variable).

# --- Django ------------------------------------------------------------------
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria
DEBUG=False
# Hosts permitidos, separados por comas (obligatorio con DEBUG=False)
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Base de datos interna (contenedor "db") ---------------------------------
# DB_HOST/DB_PORT los fija docker-compose.yml (db:5432); no hace falta tocarlos.
DB_NAME=grafiexpress
DB_USER=grafiexpress
DB_PASSWORD=cambiame
# Dump a restaurar la PRIMERA vez que se crea la base (archivo dentro de
# docker/db/seed/). Vacío = base limpia, Django crea las tablas con migrate.
DB_SEED_FILE=

# --- Puertos -----------------------------------------------------------------
# Puerto público de la app (nginx)
APP_PORT=8002
# Solo en modo dev: puerto de Postgres publicado en 127.0.0.1
DB_EXPOSE_PORT=5433

# --- Gunicorn ----------------------------------------------------------------
WEB_CONCURRENCY=3

# --- Backups automáticos (servicio "backup") ---
# Hora del backup diario y cuántos días se conservan en docker/db/backups/
BACKUP_HORA=02:00
BACKUP_DIAS=14
