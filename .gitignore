# Add any directories, files, or patterns you don't want to be tracked by version control
.idea/
*/*.pyc
*.pyc
*/*/*.pyc
*/*/*/*.pyc
.svn/
*.log

# Variables de entorno / secretos locales (usar .env.example como plantilla)
.env
__pycache__/

# Estáticos recolectados para el contenedor Docker (se regeneran con collectstatic)
static_volume/

# Dumps de semilla y backups de la base interna de Docker
docker/db/seed/*
!docker/db/seed/.gitkeep
docker/db/backups/*
!docker/db/backups/.gitkeep

# Datos reales / backups / bases locales: nunca en el repo
*.backup
*.sqlite3
backups/
ip_publica.txt
*.local.md
